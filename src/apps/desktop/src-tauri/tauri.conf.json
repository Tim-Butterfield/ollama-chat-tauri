{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "resources": [
      "../ollamachat.db",
      "../init.sql"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "dmg",
      "msi"
    ]
  },
  "productName": "OllamaChat",
  "mainBinaryName": "OllamaChat",
  "version": "0.5.0",
  "identifier": "com.ollamachat.desktop",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OllamaChat",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "useHttpsScheme": true
      }
    ]
  }
}